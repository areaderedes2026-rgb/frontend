{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "frontend-web-muni",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  }
}
